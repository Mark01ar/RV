stics end-to-end transactions for small-and medium-sized businesses to global enterprises. Uber Technologies, Inc. has strategic partnership with Mews to embed ride booking, real-time tracking and integrated billing directly into the Mews platform. The company was formerly known as Ubercab, Inc. and changed its name to Uber Technologies, Inc. in February 2011. Uber Technologies, Inc. was founded in 2009 and is headquartered in San Francisco, California.","web":"https://www.uber.com","empleados":37300.0,"precio_bloque":{"precio":69.08999633789062,"r1m":-0.03384150085367921,"r3m":-0.12032091249655763,"r6m":-0.09271181938964246,"r12m":-0.2500000621151295,"ytd":-0.16618397503053695,"r12m_spy":0.11815412577786621,"mom12_1":-0.2237299174539621,"vs_ma200":-0.051942202340235166,"max52":94.0999984741211,"vs_max52":-0.2657811109647211,"vol1y":0.3505178400244715,"beta":1.2214426454312652,"caida_max_5y":-0.5528846189916745,"serie":{"f":["2021-11-19","2021-11-26","2021-12-03","2021-12-10","2021-12-17","2021-12-24","2021-12-31","2022-01-07","2022-01-14","2022-01-21","2022-01-28","2022-02-04","2022-02-11","2022-02-18","2022-02-25","2022-03-04","2022-03-11","2022-03-18","2022-03-25","2022-04-01","2022-04-08","2022-04-15","2022-04-22","2022-04-29","2022-05-06","2022-05-13","2022-05-20","2022-05-27","2022-06-03","2022-06-10","2022-06-17","2022-06-24","2022-07-01","2022-07-08","2022-07-15","2022-07-22","2022-07-29","2022-08-05","2022-08-12","2022-08-19","2022-08-26","2022-09-02","2022-09-09","2022-09-16","2022-09-23","2022-09-30","2022-10-07","2022-10-14","2022-10-21","2022-10-28","2022-11-04","2022-11-11","2022-11-18","2022-11-25","2022-12-02","2022-12-09","2022-12-16","2022-12-23","2022-12-30","2023-01-06","2023-01-13","2023-01-20","2023-01-27","2023-02-03","2023-02-10","2023-02-17","2023-02-24","2023-03-03","2023-03-10","2023-03-17","2023-03-24","2023-03-31","2023-04-07","2023-04-14","2023-04-21","2023-04-28","2023-05-05","2023-05-12","2023-05-19","2023-05-26","2023-06-02","2023-06