nsumer, enterprise, IoT, and data center, as well as non-marketable and marketable equity securities, and convertible debt instruments. It is also involved in Qualcomm government technologies and data center businesses; and modular businesses that provides software platforms, tools, and cloud-based services that enable developers and enterprises to build, deploy, and scale AI applications across heterogeneous computing environments. QUALCOMM Incorporated was incorporated in 1985 and is headquartered in San Diego, California.","web":"https://www.qualcomm.com","empleados":57000.0,"precio_bloque":{"precio":164.01499938964844,"r1m":-0.06544159891938217,"r3m":0.013693541443375645,"r6m":-0.30317542453003876,"r12m":-0.03331061902675869,"ytd":-0.037001774877514104,"r12m_spy":0.11815412577786621,"mom12_1":0.03438092242867952,"vs_ma200":-0.027491514705276443,"max52":248.74249267578125,"vs_max52":-0.3406233184153593,"vol1y":0.5493636391105413,"beta":1.7303281545068196,"caida_max_5y":-0.44288422476904776,"serie":{"f":["2021-11-19","2021-11-26","2021-12-03","2021-12-10","2021-12-17","2021-12-24","2021-12-31","2022-01-07","2022-01-14","2022-01-21","2022-01-28","2022-02-04","2022-02-11","2022-02-18","2022-02-25","2022-03-04","2022-03-11","2022-03-18","2022-03-25","2022-04-01","2022-04-08","2022-04-15","2022-04-22","2022-04-29","2022-05-06","2022-05-13","2022-05-20","2022-05-27","2022-06-03","2022-06-10","2022-06-17","2022-06-24","2022-07-01","2022-07-08","2022-07-15","2022-07-22","2022-07-29","2022-08-05","2022-08-12","2022-08-19","2022-08-26","2022-09-02","2022-09-09","2022-09-16","2022-09-23","2022-09-30","2022-10-07","2022-10-14","2022-10-21","2022-10-28","2022-11-04","2022-11-11","2022-11-18","2022-11-25","2022-12-02","2022-12-09","2022-12-16","2022-12-23","2022-12-30","2023-01-06","2023-01-13","2023-01-20","2023-01-27","2023-02-03","2023-02-10","2023-02-17","2023-02-24","2023-03-03","2023-03-10","2023-03-17","2023-03-24","2023-03-31","2023-04-07","2023-04-14","2023-04-21","20